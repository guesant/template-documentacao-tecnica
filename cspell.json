{
  "version": "0.2",
  "import": ["@cspell/dict-pt-br/cspell-ext.json"],
  "language": "pt_BR",
  "dictionaries": ["termos-do-projeto"],
  "dictionaryDefinitions": [
    {
      "name": "termos-do-projeto",
      "path": "./cspell-termos-do-projeto.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    "site/**",
    "node_modules/**",
    ".venv-check/**",
    "package-lock.json"
  ],
  "ignoreRegExpList": [
    "/```[\\s\\S]*?```/g",
    "/`[^`\\n]+`/g"
  ],
  "useGitignore": true
}
